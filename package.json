{
  "name": "wardzero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/verify-build.mjs",
    "verify:artifact": "node scripts/verify-build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ai-live": "vitest run --config vitest.live.config.ts tests/live/note-evaluation.probe.ts",
    "test:ai-smoke": "vitest run --config vitest.live.config.ts tests/live/gemini.probe.ts",
    "test:early-warning": "vitest run tests/early-warning.test.ts",
    "test:early-warning-live": "vitest run --config vitest.live.config.ts tests/live/early-warning.probe.ts",
    "test:email": "playwright test --config playwright.email.config.ts",
    "test:e2e-live": "playwright test --config playwright.live.config.ts",
    "test:worker": "playwright test --config playwright.worker.config.ts",
    "test:worker:production": "playwright test --config playwright.worker.production.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "6.2.7",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}

# Local, single-process PGlite directory. Never share between running app instances.
WARDZERO_DATA_NAME=wardzero

# Optional live note interpretation. Keys belong in .env.local, never in source control.
# WARDZERO_AI_PROVIDER=gemini
# WARDZERO_AI_MODEL=gemini-3.5-flash-lite
# WARDZERO_AI_API_KEY=
# Gemini base URL is selected automatically; OpenAI-compatible alternative:
# WARDZERO_AI_PROVIDER=openai
# WARDZERO_AI_BASE_URL=https://api.openai.com/v1
# WARDZERO_AI_MODEL=your-structured-output-model
# Local alternative: provider=ollama, base URL=http://127.0.0.1:11434, model=an-installed-model
